# API environment. Keep real keys in your local .env or secret store.
INVESTINATOR_DEMO_MODE=true
DATABASE_URL=sqlite:///./investinator.db
INVESTINATOR_OPENAI_MODEL=
INVESTINATOR_OPENAI_FAST_MODEL=
INVESTINATOR_OPENAI_REASONING_MODEL=
OPENAI_API_KEY=
INVESTINATOR_OPENAI_STORE=false
# Optional read-only Kafka broker health.
KAFKA_BOOTSTRAP_SERVERS=

# Optional local Elasticsearch. Launch with: docker compose --profile log-search up -d
# The API container must use the Docker service hostname.
INVESTINATOR_ELASTICSEARCH_URL=
INVESTINATOR_ELASTICSEARCH_INDEX=logs-investinator-demo
INVESTINATOR_ELASTICSEARCH_TENANT_FIELD=tenant_id
INVESTINATOR_ELASTICSEARCH_API_KEY=
